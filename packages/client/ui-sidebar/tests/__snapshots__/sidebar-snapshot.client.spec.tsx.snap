            style="display: contents;"
          />
        </div>
        <div
          class="settingsArea"
        >
          <div
            data-slot="sidebar.settings"
            style="display: contents;"
          />
        </div>
      </div>
    </div>
    <div
      class="workspacePane"
      data-sidebar-workspace-pane=""
      style="width: 244px;"
    >
      <div
        class="logoRow"
        data-window-drag="true"
      >
        <div
          class="brandName"
        >
          <div
            data-slot="sidebar.brand.name"
            style="display: contents;"
          >
            <button
              aria-label="CrewON 1.2.3-rc.4-abc1234-dirty"
              class="localBuildBrand"
              type="button"
            >
              <span
                class="localBuildTitle"
              >
                CrewON
              </span>
            </button>
          </div>
        </div>
      </div>
      <button
        aria-label="New session"
        class="newSession"
        type="button"
      >
        <span
          class="newSessionContent"
        >
          <svg
            aria-hidden="true"
            data-content="532cf99a"
            data-icon="dsw-icon-new-chat-outline-medium"
            height="16"
            width="16"
          />
          <span
            class="newSessionLabel"
          >
            New Session
          </span>
        </span>
      </button>
      <div
        class="scrollRegion"
      >
        <div
          class="scrollArea"
          data-sidebar-scrollport=""
        >
          <div
            class="regionArea"
          >
            <div
              data-slot="sidebar.workspaces"
              style="display: contents;"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
`;

exports[`sidebar shell snapshots > renders the permanent Windows rail and collapsible workspace pane > windows collapsed 1`] = `
