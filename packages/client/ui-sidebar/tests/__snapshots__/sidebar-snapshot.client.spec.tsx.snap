        class="logoRow"
        data-window-drag="true"
      >
        <div
          class="brandName"
        >
          <div
            data-slot="sidebar.brand.name"
            style="display: contents;"
          >
            <button
              aria-label="CrewON 1.2.3-rc.4-abc1234-dirty"
              class="localBuildBrand"
              type="button"
            >
              <span
                class="localBuildTitle"
              >
                CrewON
              </span>
            </button>
          </div>
        </div>
