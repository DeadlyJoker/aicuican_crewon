            height="16"
            width="16"
          />
          <span
            class="newSessionLabel"
          >
            New Session
          </span>
        </span>
      </button>
      <div
        class="scrollRegion"
      >
        <div
          class="scrollArea"
          data-sidebar-scrollport=""
        >
          <div
            class="regionArea"
          >
            <div
              data-slot="sidebar.workspaces"
              style="display: contents;"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
`;

